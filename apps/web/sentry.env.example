# =============================================================================
# Sentry environment variables (Phase 8 — production hardening)
# =============================================================================
#
# `.env.local` is gitignored, so this file documents the schema. Copy any
# variables you want to set into `apps/web/.env.local` and fill in real values.
#
# Without these set, the Sentry SDK initializes as a no-op — your build keeps
# working, errors just don't get reported anywhere.

# DSN for the web project — find it at:
#   Sentry → Settings → Projects → lifestyleprogramtracker-web → Client Keys (DSN)
# This is intentionally `NEXT_PUBLIC_*` so the browser SDK can read it.
NEXT_PUBLIC_SENTRY_DSN=

# Org slug — visible in your Sentry URL (https://<org>.sentry.io/...).
# Used by the build-time source map uploader.
SENTRY_ORG=

# Auth token used by the build-time source map uploader. Create one at:
#   Sentry → Settings → Auth Tokens → Create New Token
# Scopes needed: `project:releases`, `org:read`.
# Never expose this to the browser — server / CI only.
SENTRY_AUTH_TOKEN=
