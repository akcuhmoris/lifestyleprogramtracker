{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "preserve",
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@program/shared": ["../shared/src/index.ts"],
      "@program/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
